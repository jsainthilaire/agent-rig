#!/usr/bin/env bash
# Bash 3.2+; requires only standard Unix utilities. Never source project data.
set -euo pipefail
set -f
export LC_ALL=C

BEGIN_MARKER='<!-- agent-rig:begin -->'
END_MARKER='<!-- agent-rig:end -->'
RIG_ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
stage=''
lock_owned=0
legacy_lock_owned=0
applying=0
committed=0
keep_stage=0
target=''
operation=''
global_install=0
install_scope=project
provider=codex
state_directory=''
legacy_manifest=''
preset=full
dry_run=0
allow_modified=0
backup_dir=''

usage() {
    cat <<'EOF'
Usage: bash bin/agent-rig install --target DIRECTORY [options]
       bash bin/agent-rig install --global [options]
       bash bin/agent-rig uninstall --target DIRECTORY [options]
       bash bin/agent-rig uninstall --global [options]

  --provider NAME      codex (default) or claude
  --global             Codex: CODEX_HOME or ~/.codex; Claude: CLAUDE_CONFIG_DIR or ~/.claude
  --preset NAME        Install full (default), minimal, backend, or security
  --dry-run            Show changes without writing to the target
  --replace-modified   Install: replace conflicting Rig content with backups
  --remove-modified    Uninstall: remove modified Rig content with backups
  --help               Show this help

--global and --target are mutually exclusive. Project targets must already
exist; a missing provider home is created only when applying a global install.
Omitting --preset installs full. Project installation requires --target.
Existing provider configuration is preserved. Repeat the command to update an
installation or switch presets. Uninstall uses the recorded manifest and keeps
provider configuration, surrounding instructions, and backups. Rig remains opt-in
through workflow aliases.
EOF
}

die() { printf 'agent-rig: %s\n' "$*" >&2; exit 1; }
checksum() { cksum < "$1"; }

# Reject links and unexpected object types along every destination path.
check_path() {
    local rest=$1 kind=${2:-file} part prefix=$target
    [ ! -L "$target" ] || die "Target directory is a symlink: $target"
    [ ! -e "$target" ] || [ -d "$target" ] || die "Expected a directory: $target"
    while :; do
        part=${rest%%/*}
        prefix=$prefix/$part
        [ ! -L "$prefix" ] || die "Destination is a symlink: $prefix"
        if [ "$rest" = "$part" ]; then
            if [ -e "$prefix" ]; then
                if [ "$kind" = dir ]; then
                    [ -d "$prefix" ] || die "Expected a directory: $prefix"
                else
                    [ -f "$prefix" ] || die "Expected a regular file: $prefix"
                fi
            fi
            break
        fi
        [ ! -e "$prefix" ] || [ -d "$prefix" ] || die "Expected a directory: $prefix"
        rest=${rest#*/}
    done
}

snapshot() {
    local rel=$1 fingerprint
    check_path "$rel"
    # Keep the earliest observation, before rendering or comparing content.
    if awk -F '\t' -v path="$rel" '$1 == path { found = 1 } END { exit !found }' "$stage/snapshots.tsv"; then return; fi
    if [ -f "$target/$rel" ]; then fingerprint=$(checksum "$target/$rel"); else fingerprint=missing; fi
    printf '%s\t%s\n' "$rel" "$fingerprint" >> "$stage/snapshots.tsv"
}

rollback() {
    local op rel saved tmp failed=0
    printf 'agent-rig: Write failed; restoring changed files.\n' >&2
    while IFS="$(printf '\t')" read -r op rel; do
        saved=$stage/originals/$rel
        if [ -f "$saved" ]; then
            tmp=$(mktemp "$target/$(dirname -- "$rel")/.agent-rig-restore.XXXXXX") || { failed=1; continue; }
            if cp -p "$saved" "$tmp" && mv -f "$tmp" "$target/$rel"; then
                :
            else
                failed=1
                rm -f "$tmp"
            fi
        else
            rm -f "$target/$rel" || failed=1
        fi
    done < "$stage/journal.tsv"
    if [ "$failed" -ne 0 ]; then
        keep_stage=1
        printf 'agent-rig: Restoration incomplete; saved originals remain at %s/originals\n' "$stage" >&2
    fi
}

cleanup() {
    local result=$? tmp
    set +e
    if [ "$applying" -eq 1 ] && [ "$committed" -eq 0 ]; then rollback; fi
    if [ -n "$stage" ] && [ -f "$stage/temp-paths" ]; then
        while IFS= read -r tmp; do rm -f "$tmp"; done < "$stage/temp-paths"
    fi
    if [ "$lock_owned" -eq 1 ]; then rmdir "$target/$state_directory/.install-lock"; fi
    if [ "$legacy_lock_owned" -eq 1 ]; then rmdir "$target/$legacy_lock_path"; fi
    if [ -n "$stage" ] && [ "$keep_stage" -eq 0 ]; then rm -rf "$stage"; fi
    exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

[ "$#" -gt 0 ] || { usage; exit 2; }
case $1 in
    --help|-h) usage; exit 0 ;;
    install|uninstall) operation=$1; shift ;;
    *) die "Unknown command: $1" ;;
esac
while [ "$#" -gt 0 ]; do
    case $1 in
        --target|--preset|--provider)
            [ "$#" -ge 2 ] || die "Missing value for $1"
            [ -n "$2" ] || die "Empty value for $1"
            case $2 in --*) die "Missing value for $1 before $2" ;; esac
            case $1 in
                --target) target=$2 ;;
                --provider) provider=$2 ;;
                --preset)
                    [ "$operation" = install ] || die '--preset is only supported by install'
                    preset=$2 ;;
            esac
            shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        --global) global_install=1; shift ;;
        --replace-modified)
            [ "$operation" = install ] || die 'Use --remove-modified with uninstall'
            allow_modified=1; shift ;;
        --remove-modified)
            [ "$operation" = uninstall ] || die '--remove-modified is only supported by uninstall'
            allow_modified=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) die "Unknown option: $1" ;;
    esac
done
case $provider in codex|claude) ;; *) die "Unknown provider: $provider" ;; esac
PROVIDER_ROOT=$RIG_ROOT/providers/$provider
# Only trusted source adapters are sourced; destination data is never evaluated.
source "$PROVIDER_ROOT/provider.sh"
state_directory=.agent-rig/$provider
if [ "$global_install" -eq 1 ]; then
    [ -z "$target" ] || die '--global and --target are mutually exclusive'
    install_scope=global
    provider_global_target
else
    [ -n "$target" ] || die '--target or --global is required'
fi
provider_paths
case $preset in minimal|backend|security|full) ;; *) die "Unknown preset: $preset" ;; esac
while [ "$target" != / ] && [ "${target%/}" != "$target" ]; do target=${target%/}; done
case $target in *"$(printf '\t')"*|*$'\n'*) die 'Target paths cannot contain tabs or newlines' ;; esac
[ ! -L "$target" ] || die "Target directory is a symlink: $target"
if [ -d "$target" ]; then
    target=$(CDPATH= cd -- "$target" && pwd -P)
elif [ "$global_install" -eq 1 ]; then
    # Resolve a missing provider home without creating directories during preflight.
    ancestor=$target
    suffix=''
    while [ ! -d "$ancestor" ]; do
        [ ! -L "$ancestor" ] || die "Destination is a symlink: $ancestor"
        [ ! -e "$ancestor" ] || die "Expected a directory: $ancestor"
        component=$(basename -- "$ancestor")
        case $component in .|..) die "Cannot resolve missing directory components: $target" ;; esac
        suffix=/$component$suffix
        ancestor=$(dirname -- "$ancestor")
    done
    ancestor=$(CDPATH= cd -- "$ancestor" && pwd -P)
    target=${ancestor%/}$suffix
else
    die "Target directory does not exist: $target"
fi
[ "$target" != "$RIG_ROOT" ] || die 'Use a destination outside the Agent Rig source checkout'

stage=$(mktemp -d "${TMPDIR:-/tmp}/agent-rig.XXXXXX")
mkdir -p "$stage/new" "$stage/originals"
: > "$stage/operations.tsv"
: > "$stage/snapshots.tsv"
: > "$stage/conflicts"
: > "$stage/desired-files"
: > "$stage/temp-paths"
: > "$stage/journal.tsv"

agents=''
workflows=''
if [ "$operation" = install ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in
            ''|'#'*) ;;
            'agents: '*)
                [ -z "$agents" ] || die 'Duplicate agents field'
                agents=${line#agents: }
                [ -n "${agents//[[:space:]]/}" ] || die 'Empty agents field'
                ;;
            'workflows: '*)
                [ -z "$workflows" ] || die 'Duplicate workflows field'
                workflows=${line#workflows: }
                [ -n "${workflows//[[:space:]]/}" ] || die 'Empty workflows field'
                ;;
            *) die "Invalid preset line: $line" ;;
        esac
    done < "$PROVIDER_ROOT/presets/$preset.preset"
    [ -n "$agents" ] && [ -n "$workflows" ] || die 'Preset must list agents and workflows'
    seen=' '
    for role in $agents; do
        case $role in ''|*[!a-z_]*) die "Invalid agent name: $role" ;; esac
        case $seen in *" $role "*) die "Duplicate agent: $role" ;; esac
        seen=$seen$role' '
        [ -f "$PROVIDER_ROOT/agents/$role.$agent_extension" ] || die "Missing agent: $role"
    done
    seen=' '
    for workflow in $workflows; do
        case $workflow in ''|*[!a-z_]*) die "Invalid workflow name: $workflow" ;; esac
        case $seen in *" $workflow "*) die "Duplicate workflow: $workflow" ;; esac
        seen=$seen$workflow' '
        [ -f "$PROVIDER_ROOT/workflows/$workflow.md" ] || die "Missing workflow: $workflow"
    done
fi

check_path "$state_directory/manifest.tsv"
check_path "$state_directory/backups" dir
check_path "$state_directory/.install-lock" dir
manifest_path=$state_directory/manifest.tsv
# Codex alone recognizes the pre-provider layout. Keep legacy backups in place.
if [ -n "$legacy_manifest_candidate" ]; then
    check_path "$legacy_manifest_candidate"
    snapshot "$legacy_manifest_candidate"
    if [ -f "$target/$legacy_manifest_candidate" ]; then
        [ ! -f "$target/$manifest_path" ] || die "Both legacy and provider manifests exist; reconcile $provider_label state manually"
        check_path "$legacy_lock_path" dir
        legacy_manifest=$legacy_manifest_candidate
        if [ "$operation" = uninstall ]; then manifest_path=$legacy_manifest; fi
    fi
fi
snapshot "$manifest_path"
read_manifest=${legacy_manifest:-$manifest_path}
if [ -f "$target/$read_manifest" ]; then
    # Providers define owned paths; core validates lifecycle records and checksums.
    previous_scope=$(awk -F '\t' '$1 == "scope" { print $2 }' "$target/$read_manifest")
    case ${previous_scope:-project} in
        project|global) [ "${previous_scope:-project}" = "$install_scope" ] || die 'Installation scope differs from the manifest; use the original --global or --target mode' ;;
    esac
    provider_manifest_patterns
    awk -F '\t' -v provider="$provider" -v files="$manifest_files" -v blocks="$manifest_blocks" '
        NR == 1 { if (NF != 2 || $1 != "agent-rig-manifest" || $2 != "1") exit 1; next }
        $1 == "provider" { if (NF != 2 || $2 != provider || ++providers > 1) exit 1; next }
        $1 == "preset" { if (NF != 2 || $2 !~ /^(minimal|backend|security|full)$/ || ++presets > 1) exit 1; next }
        $1 == "scope" { if (NF != 2 || $2 !~ /^(project|global)$/ || ++scopes > 1) exit 1; scope = $2; next }
        $1 == "file" || $1 == "block" {
            if (NF != 4 || $3 !~ /^[0-9]+$/ || $4 !~ /^[0-9]+$/ || seen[$2]++) exit 1
            if ($1 == "file" && $2 !~ files) exit 1
            if ($1 == "block" && ($2 !~ blocks || ++block_count > 1)) exit 1
            next
        }
        { exit 1 }
        END { if (presets != 1 || block_count != 1) exit 1 }
    ' "$target/$read_manifest" || die "Invalid install manifest; reconcile $read_manifest manually"
    cp "$target/$read_manifest" "$stage/old-manifest.tsv"
    previous_scope=$(awk -F '\t' '$1 == "scope" { print $2 }' "$stage/old-manifest.tsv")
    [ "${previous_scope:-project}" = "$install_scope" ] || die 'Installation scope differs from the manifest; use the original --global or --target mode'
else
    : > "$stage/old-manifest.tsv"
    if [ "$operation" = uninstall ]; then
        printf 'No install manifest found at %s/%s; no files removed.\n' "$target" "$manifest_path"
        exit 0
    fi
fi

old_checksum() {
    awk -F '\t' -v kind="$1" -v path="$2" '$1 == kind && $2 == path { print $3 " " $4 }' "$stage/old-manifest.tsv"
}

plan_write() {
    local rel=$1
    snapshot "$rel"
    if [ -f "$target/$rel" ] && cmp -s "$stage/new/$rel" "$target/$rel"; then return; fi
    printf 'write\t%s\n' "$rel" >> "$stage/operations.tsv"
}

conflict() {
    if [ "$allow_modified" -eq 0 ]; then printf '%s\n' "$1" >> "$stage/conflicts"; fi
}

prepare_managed_file() {
    local source=$1 rel=$2 previous current crc bytes
    snapshot "$rel"
    mkdir -p "$stage/new/$(dirname -- "$rel")"
    provider_render_file "$source" "$stage/new/$rel"
    if [ -f "$target/$rel" ]; then
        previous=$(old_checksum file "$rel")
        current=$(checksum "$target/$rel")
        if [ -n "$previous" ]; then
            if [ "$current" != "$previous" ] && ! cmp -s "$stage/new/$rel" "$target/$rel"; then
                conflict "$rel (locally modified)"
            fi
        elif ! cmp -s "$stage/new/$rel" "$target/$rel"; then
            conflict "$rel (unmanaged destination collision)"
        fi
    fi
    read -r crc bytes < <(checksum "$stage/new/$rel")
    printf 'file\t%s\t%s\t%s\n' "$rel" "$crc" "$bytes" >> "$stage/new-manifest.tsv"
    printf '%s\n' "$rel" >> "$stage/desired-files"
    plan_write "$rel"
}

if [ "$operation" = install ]; then
    provider_prepare_install
    printf 'agent-rig-manifest\t1\nprovider\t%s\npreset\t%s\nscope\t%s\n' "$provider" "$preset" "$install_scope" > "$stage/new-manifest.tsv"
    for role in $agents; do prepare_managed_file "$PROVIDER_ROOT/agents/$role.$agent_extension" "$agent_directory/$agent_prefix$role.$agent_extension"; done
    for workflow in $workflows; do prepare_managed_file "$PROVIDER_ROOT/workflows/$workflow.md" "$state_directory/workflows/$workflow.md"; done
    provider_extra_files

    provider_choose_instructions

    # Retire only files listed by our previous installation.
    while IFS="$(printf '\t')" read -r kind rel crc bytes; do
        [ "$kind" = file ] || continue
        if grep -Fqx -- "$rel" "$stage/desired-files"; then continue; fi
        snapshot "$rel"
        if [ -f "$target/$rel" ]; then
            [ "$(checksum "$target/$rel")" = "$crc $bytes" ] || conflict "$rel (locally modified; removed by preset switch)"
            printf 'delete\t%s\n' "$rel" >> "$stage/operations.tsv"
        fi
    done < "$stage/old-manifest.tsv"

    {
        printf '%s\n# Agent Rig\n\n' "$BEGIN_MARKER"
        provider_render_instructions
        printf '\n## Installed preset (active Rig requests only)\n\nInstalled preset: **%s**.\nInstallation scope: **%s**.\n\n' "$preset" "$install_scope"
        printf 'Available Rig roles and their %s agent names:\n\n' "$provider_label"
        for role in $agents; do printf -- '- %s: `%s%s`\n' "$role" "$agent_prefix" "$role"; done
        printf '\nAvailable workflows:\n\n'
        for workflow in $workflows; do
            if [ "$global_install" -eq 1 ]; then
                printf -- '- `@%s`: `%s/%s/workflows/%s.md`\n' "$workflow" "$target" "$state_directory" "$workflow"
            else
                printf -- '- `@%s`: [%s/workflows/%s.md](%s/workflows/%s.md)\n' "$workflow" "$state_directory" "$workflow" "$state_directory" "$workflow"
            fi
        done
        printf '\n%s\n' "$END_MARKER"
    } > "$stage/block"
fi

prepare_instruction_file() {
    local rel=$1 replacement=$2 protect_missing=${3:-1} block_present=0 start finish total previous
    snapshot "$rel"
    if [ -f "$target/$rel" ]; then
        # Byte offsets preserve all content outside the section, including EOF style.
        if ! awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
            BEGIN { pos = 0 }
            {
                line = $0
                sub(/\r$/, "", line)
                if (index(line, begin) && line != begin) bad = 1
                if (index(line, end) && line != end) bad = 1
                if (line == begin) { if (++begins != 1 || ends) bad = 1; start = pos }
                if (line == end) { if (begins != 1 || ++ends != 1) bad = 1; finish = pos + length($0) + 1 }
                pos += length($0) + 1
            }
            END {
                if (bad || begins != ends) exit 1
                if (begins) print start, finish
            }
        ' "$target/$rel" > "$stage/offsets"; then
            die "Malformed or duplicate Agent Rig markers in $rel; reconcile them manually"
        fi
        if [ -s "$stage/offsets" ]; then
            block_present=1
            read -r start finish < "$stage/offsets"
            total=$(wc -c < "$target/$rel")
            [ "$finish" -le "$total" ] || finish=$total
            dd if="$target/$rel" of="$stage/existing-block" bs=1 skip="$start" count="$((finish - start))" 2>/dev/null
            previous=$(old_checksum block "$rel")
            if [ -n "$previous" ]; then
                if [ "$(checksum "$stage/existing-block")" != "$previous" ] && ! cmp -s "$replacement" "$stage/existing-block"; then
                    conflict "$rel (managed section locally modified)"
                fi
            elif ! cmp -s "$replacement" "$stage/existing-block"; then
                conflict "$rel (unmanaged marked section)"
            fi
            dd if="$target/$rel" of="$stage/new/$rel" bs=1 count="$start" 2>/dev/null
            cat "$replacement" >> "$stage/new/$rel"
            dd if="$target/$rel" bs=1 skip="$finish" 2>/dev/null >> "$stage/new/$rel"
        else
            cp "$target/$rel" "$stage/new/$rel"
            if [ -s "$replacement" ]; then
                if [ -s "$target/$rel" ]; then printf '\n\n' >> "$stage/new/$rel"; fi
                cat "$replacement" >> "$stage/new/$rel"
            fi
        fi
    elif [ -s "$replacement" ]; then
        cp "$replacement" "$stage/new/$rel"
    fi
    if [ "$protect_missing" -eq 1 ] && [ "$block_present" -eq 0 ] && [ -n "$(old_checksum block "$rel")" ]; then
        conflict "$rel (previously installed managed section was removed)"
    fi
    if [ -f "$stage/new/$rel" ]; then plan_write "$rel"; fi
}

previous_instructions=$(awk -F '\t' '$1 == "block" { print $2 }' "$stage/old-manifest.tsv")
config_preserved=0
if [ "$operation" = uninstall ]; then
    # Only the manifest identifies owned files; missing files are already removed.
    while IFS="$(printf '\t')" read -r kind rel crc bytes; do
        [ "$kind" = file ] || continue
        snapshot "$rel"
        if [ -f "$target/$rel" ]; then
            [ "$(checksum "$target/$rel")" = "$crc $bytes" ] || conflict "$rel (locally modified; removed by uninstall)"
            printf 'delete\t%s\n' "$rel" >> "$stage/operations.tsv"
        fi
    done < "$stage/old-manifest.tsv"
    : > "$stage/empty-block"
    prepare_instruction_file "$previous_instructions" "$stage/empty-block" 0
    # Protect additional Rig-marked sections rather than silently leaving them active.
    for rel in $instruction_candidates; do
        [ "$rel" != "$previous_instructions" ] || continue
        snapshot "$rel"
        if [ -f "$target/$rel" ] && { grep -Fq -- "$BEGIN_MARKER" "$target/$rel" || grep -Fq -- "$END_MARKER" "$target/$rel"; }; then
            prepare_instruction_file "$rel" "$stage/empty-block" 0
        fi
    done
    printf 'delete\t%s\n' "$manifest_path" >> "$stage/operations.tsv"
else
    if [ -n "$previous_instructions" ] && [ "$previous_instructions" != "$instructions_file" ]; then
        : > "$stage/empty-block"
        prepare_instruction_file "$previous_instructions" "$stage/empty-block"
    fi
    prepare_instruction_file "$instructions_file" "$stage/block"
    read -r crc bytes < <(checksum "$stage/block")
    printf 'block\t%s\t%s\t%s\n' "$instructions_file" "$crc" "$bytes" >> "$stage/new-manifest.tsv"

    provider_prepare_config
    mkdir -p "$stage/new/$state_directory"
    cp "$stage/new-manifest.tsv" "$stage/new/$manifest_path"
    plan_write "$manifest_path"
    if [ -n "$legacy_manifest" ]; then
        printf 'delete\t%s\n' "$legacy_manifest" >> "$stage/operations.tsv"
    fi
fi

if [ -s "$stage/conflicts" ]; then
    printf 'agent-rig: %s stopped before writing. Conflicts:\n' "$operation" >&2
    while IFS= read -r line; do printf '  %s\n' "$line" >&2; done < "$stage/conflicts"
    if [ "$operation" = uninstall ]; then
        die 'Reconcile these changes, or rerun with --remove-modified to remove them with backups'
    else
        die 'Reconcile these changes, or rerun with --replace-modified to replace them with backups'
    fi
fi

if [ "$operation" = uninstall ]; then
    printf 'Agent Rig %s uninstall: %s -> %s\n' "$provider" "$install_scope" "$target"
else
    printf 'Agent Rig %s: %s -> %s\n' "$provider" "$preset" "$target"
fi
if [ ! -s "$stage/operations.tsv" ]; then
    printf 'Already up to date.\n'
else
    while IFS="$(printf '\t')" read -r op rel; do printf '  %s %s\n' "$op" "$rel"; done < "$stage/operations.tsv"
fi

if [ "$dry_run" -eq 1 ]; then
    printf 'Dry run: no target files changed.\n'
elif [ -s "$stage/operations.tsv" ]; then
    check_path .agent-rig dir
    check_path "$state_directory/backups" dir
    check_path "$state_directory/.install-lock" dir
    mkdir -p "$target/$state_directory"
    if ! mkdir "$target/$state_directory/.install-lock" 2>/dev/null; then
        die "Another Agent Rig operation holds $state_directory/.install-lock; remove a stale lock only after confirming no install or uninstall is running"
    fi
    lock_owned=1
    if [ -n "$legacy_manifest" ]; then
        if ! mkdir "$target/$legacy_lock_path" 2>/dev/null; then
            die "Another Agent Rig operation holds the legacy $legacy_lock_path"
        fi
        legacy_lock_owned=1
    fi
    # Recheck preflight snapshots after taking the lock, including preserved config.
    while IFS="$(printf '\t')" read -r rel expected; do
        check_path "$rel"
        if [ -f "$target/$rel" ]; then current=$(checksum "$target/$rel"); else current=missing; fi
        [ "$current" = "$expected" ] || die "Destination changed during preflight: $rel; rerun $operation"
    done < "$stage/snapshots.tsv"
    while IFS="$(printf '\t')" read -r op rel; do
        if [ -f "$target/$rel" ]; then
            mkdir -p "$stage/originals/$(dirname -- "$rel")"
            cp -p "$target/$rel" "$stage/originals/$rel"
            if [ -z "$backup_dir" ]; then
                mkdir -p "$target/$state_directory/backups"
                backup_dir=$(mktemp -d "$target/$state_directory/backups/$(date -u +%Y%m%dT%H%M%SZ).XXXXXX")
            fi
            mkdir -p "$backup_dir/$(dirname -- "$rel")"
            cp -p "$target/$rel" "$backup_dir/$rel"
        fi
    done < "$stage/operations.tsv"
    applying=1
    while IFS="$(printf '\t')" read -r op rel; do
        check_path "$rel"
        # Journal before each mutation so a failed operation can also be restored.
        printf '%s\t%s\n' "$op" "$rel" >> "$stage/journal.tsv"
        if [ "$op" = delete ]; then
            rm "$target/$rel"
        else
            mkdir -p "$target/$(dirname -- "$rel")"
            tmp=$(mktemp "$target/$(dirname -- "$rel")/.agent-rig-write.XXXXXX")
            printf '%s\n' "$tmp" >> "$stage/temp-paths"
            if [ -f "$stage/originals/$rel" ]; then
                cp -p "$stage/originals/$rel" "$tmp"
                cat "$stage/new/$rel" > "$tmp"
            else
                cat "$stage/new/$rel" > "$tmp"
                chmod 644 "$tmp"
            fi
            mv -f "$tmp" "$target/$rel"
        fi
    done < "$stage/operations.tsv"
    committed=1
    if [ "$operation" = uninstall ]; then
        printf 'Uninstalled successfully.\n'
    else
        printf 'Installed successfully.\n'
    fi
    if [ -n "$backup_dir" ]; then printf 'Backups: %s\n' "$backup_dir"; fi
fi

provider_report
